PORT=3000
SESSION_SECRET=change-this-local-secret
VEL_OS_ADMIN_CODE=admin7945
VEL_OS_ADMIN_DEVICE_IDS=3fa56c0a,a9f794a2-9e8f-4d01-acdc-3b707472ae2e
# Remote Deck has its own shared control code.
REMOTE_DECK_CODE=callan123

YOUTUBE_API_KEY=your-youtube-data-api-key

# Required for published Global YouTube Favs and Global Chat to persist forever.
# Vercel Redis usually gives REDIS_URL.
REDIS_URL=
# Older KV/Upstash setups may give REST env vars instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5-mini

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-domain.example/api/tiktok/auth/callback

# Messages uses data/messenger.json locally and requires Redis on Vercel.
# Calls across restrictive NATs require a TURN relay (comma-separated URLs).
MESSENGER_TURN_URLS=
MESSENGER_TURN_SECRET=
# For relays using fixed credentials instead of a shared signing secret:
MESSENGER_TURN_USERNAME=
MESSENGER_TURN_PASSWORD=
